<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_dark"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Voice Message"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tap to record (max 10s)"
        android:textColor="#7A90AE"
        android:textSize="12sp"
        android:layout_marginBottom="20dp" />

    <!-- 타이머 -->
    <TextView
        android:id="@+id/voice_timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="00:00 / 00:10"
        android:textColor="#00E5D1"
        android:textSize="32sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:layout_marginBottom="20dp" />

    <!-- 녹음/정지 버튼 -->
    <ImageView
        android:id="@+id/voice_rec_btn"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:background="@drawable/bg_voice_rec"
        android:src="@android:drawable/ic_btn_speak_now"
        android:padding="20dp"
        app:tint="#FFFFFF"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/voice_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tap to start"
        android:textColor="#95B0D4"
        android:textSize="13sp"
        android:layout_marginBottom="20dp" />

    <!-- 버튼 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button
            android:id="@+id/voice_cancel"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="Cancel"
            android:textColor="#95B0D4"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:background="@drawable/bg_btn_cancel" />
        <Button
            android:id="@+id/voice_attach"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1.3"
            android:layout_marginStart="6dp"
            android:text="Attach"
            android:textColor="#0A1628"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:enabled="false"
            android:background="@drawable/bg_btn_primary" />
    </LinearLayout>

</LinearLayout>