<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#0D1F3C">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Register Group"
        android:textColor="#00E5D1"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <!-- 그룹번호 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Group No."
        android:textColor="#95B0D4"
        android:textSize="12sp"/>
    <TextView
        android:id="@+id/tv_group_no"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="1번"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:paddingTop="4dp"
        android:paddingBottom="12dp"/>

    <!-- 그룹명 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Group Name (optional)"
        android:textColor="#95B0D4"
        android:textSize="12sp"/>
    <EditText
        android:id="@+id/et_group_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="e.g. 1st Platoon"
        android:textColorHint="#5A7299"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:maxLength="20"
        android:layout_marginBottom="12dp"/>

    <!-- 구성원 선택 헤더 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp">
        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Select Members (Contacts)"
            android:textColor="#95B0D4"
            android:textSize="12sp"/>
        <TextView
            android:id="@+id/tv_selected_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="선택: 0명"
            android:textColor="#00E5D1"
            android:textSize="12sp"/>
    </LinearLayout>

    <!-- 연락처 목록 (체크박스 다중선택) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_contacts"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:background="#0A1628"/>

    <TextView
        android:id="@+id/tv_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No contacts registered.\nAdd a contact first."
        android:textColor="#5A7299"
        android:textSize="13sp"
        android:gravity="center"
        android:padding="20dp"
        android:visibility="gone"/>

    <!-- 버튼 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp">
        <Button
            android:id="@+id/btn_cancel"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:textColor="#95B0D4"
            android:background="@android:color/transparent"/>
        <Button
            android:id="@+id/btn_register"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Send Registration"
            android:textColor="#0A1628"
            android:textStyle="bold"
            android:backgroundTint="#00E5D1"/>
    </LinearLayout>
</LinearLayout>
