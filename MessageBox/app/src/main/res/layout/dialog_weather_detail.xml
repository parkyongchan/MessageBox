<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#0F2A44"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/wxd_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="\ub0a0\uc528 \uc0c1\uc138"
            android:textColor="#00E5D1"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/wxd_loc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#95B0D4"
            android:textSize="12sp"
            android:layout_marginTop="4dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1E4060"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="\ud604\uc7ac"
            android:textColor="#E8F1FB"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/wxd_current"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#C5D6EC"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp"
            android:layout_marginTop="6dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1E4060"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="7\uc77c \uc608\ubcf4"
            android:textColor="#E8F1FB"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/wxd_forecast"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="6dp" />

        <TextView
            android:id="@+id/wxd_close"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="\ub2eb\uae30"
            android:gravity="center"
            android:padding="12dp"
            android:layout_marginTop="16dp"
            android:background="#123859"
            android:textColor="#00E5D1"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>
</ScrollView>