<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A1F38">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:background="#0F3D5C">
        <TextView
            android:id="@+id/wd_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Weather Detail"
            android:textColor="#00E5D1"
            android:textSize="18sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/wd_clear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Clear All"
            android:padding="8dp"
            android:layout_marginEnd="8dp"
            android:textColor="#FF6D6D"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />
        <TextView
            android:id="@+id/wd_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Close"
            android:padding="8dp"
            android:textColor="#00E5D1"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Map (my location + weather) -->
    <org.osmdroid.views.MapView
        android:id="@+id/wd_map"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="38" />

    <!-- History list (past received, by date) -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="History"
        android:textColor="#95B0D4"
        android:textSize="12sp"
        android:textStyle="bold"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="4dp"
        android:background="#0D2A47" />
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/wd_history"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="22"
        android:background="#0A1F38" />

    <!-- Selected detail (current + 7-day) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="40"
        android:background="#0A1F38"
        android:padding="12dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:id="@+id/wd_current"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#C5D6EC"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp" />
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1E4060"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="7-Day Forecast"
                android:textColor="#E8F1FB"
                android:textSize="14sp"
                android:textStyle="bold" />
            <LinearLayout
                android:id="@+id/wd_forecast"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="6dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>