<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:background="?android:attr/selectableItemBackground">

    <View
        android:id="@+id/wx_bar"
        android:layout_width="4dp"
        android:layout_height="44dp"
        android:background="#00C9FF"
        android:layout_marginEnd="10dp" />

    <ImageView
        android:id="@+id/wx_icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_btn_weather"
        android:layout_marginEnd="10dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/wx_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="\uc721\uc0c1 \ub0a0\uc528"
            android:textColor="#E8F1FB"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/wx_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#95B0D4"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/wx_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#5C7599"
            android:textSize="10sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/wx_detail"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@android:drawable/ic_menu_more"
        app:tint="#00C9FF"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:contentDescription="detail" />
</LinearLayout>