<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A1628">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#0D1628"
        android:paddingHorizontal="14dp">
        <TextView
            android:id="@+id/tac_detail_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="TACTICAL"
            android:textColor="#00E5D1"
            android:textSize="13sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tac_detail_export"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EXPORT"
            android:textColor="#00E5D1"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/bg_map_button"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:layout_marginEnd="8dp" />
        <TextView
            android:id="@+id/tac_detail_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CLOSE"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/bg_map_button"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp" />
    </LinearLayout>

    <!-- Date range bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#0D1628"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp">

        <TextView
            android:id="@+id/tac_start_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Start"
            android:textColor="#9FB3C8"
            android:textSize="11sp"
            android:gravity="center"
            android:background="@drawable/bg_map_button"
            android:paddingVertical="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="~"
            android:textColor="#4B6483"
            android:paddingHorizontal="6dp" />

        <TextView
            android:id="@+id/tac_end_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="End"
            android:textColor="#9FB3C8"
            android:textSize="11sp"
            android:gravity="center"
            android:background="@drawable/bg_map_button"
            android:paddingVertical="6dp" />

        <TextView
            android:id="@+id/tac_date_apply"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Apply"
            android:textColor="#00E5D1"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/bg_map_button"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:layout_marginStart="6dp" />

        <TextView
            android:id="@+id/tac_date_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="All"
            android:textColor="#9FB3C8"
            android:textSize="11sp"
            android:background="@drawable/bg_map_button"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:layout_marginStart="6dp" />
    </LinearLayout>

    <!-- Quick period chips -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#0D1628"
        android:paddingHorizontal="10dp"
        android:paddingBottom="6dp">

        <TextView android:id="@+id/tac_chip_24h" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="24h" android:textColor="#9FB3C8" android:textSize="11sp" android:gravity="center" android:background="@drawable/bg_map_button" android:paddingVertical="5dp" android:layout_marginEnd="4dp" />
        <TextView android:id="@+id/tac_chip_48h" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="48h" android:textColor="#9FB3C8" android:textSize="11sp" android:gravity="center" android:background="@drawable/bg_map_button" android:paddingVertical="5dp" android:layout_marginEnd="4dp" />
        <TextView android:id="@+id/tac_chip_3d" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="3d" android:textColor="#9FB3C8" android:textSize="11sp" android:gravity="center" android:background="@drawable/bg_map_button" android:paddingVertical="5dp" android:layout_marginEnd="4dp" />
        <TextView android:id="@+id/tac_chip_7d" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="7d" android:textColor="#9FB3C8" android:textSize="11sp" android:gravity="center" android:background="@drawable/bg_map_button" android:paddingVertical="5dp" android:layout_marginEnd="4dp" />
        <TextView android:id="@+id/tac_chip_30d" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="30d" android:textColor="#9FB3C8" android:textSize="11sp" android:gravity="center" android:background="@drawable/bg_map_button" android:paddingVertical="5dp" />
    </LinearLayout>

    <!-- Map + overlay controls -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="4">

        <org.osmdroid.views.MapView
            android:id="@+id/tac_detail_map"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Online/Offline toggle (top-left) -->
        <include
            layout="@layout/view_map_mode_toggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="10dp" />

        <!-- Zoom controls (right) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="10dp"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/tac_detail_zoom_in"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_map_button"
                android:src="@android:drawable/ic_input_add"
                android:contentDescription="Zoom in" />

            <ImageButton
                android:id="@+id/tac_detail_zoom_out"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_map_button"
                android:src="@android:drawable/ic_delete"
                android:contentDescription="Zoom out" />

            <ImageButton
                android:id="@+id/tac_detail_fit"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/bg_map_button"
                android:src="@android:drawable/ic_menu_crop"
                android:contentDescription="Fit all" />

            <ImageButton
                android:id="@+id/tac_detail_coord"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_map_button"
                android:src="@android:drawable/ic_menu_sort_by_size"
                android:contentDescription="Toggle list" />

            <ImageButton
                android:id="@+id/tac_detail_track"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_map_button"
                android:src="@android:drawable/ic_menu_mylocation"
                android:contentDescription="My location tracking" />

            <ImageButton
                android:id="@+id/tac_detail_compass"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_map_button"
                android:src="@android:drawable/ic_menu_compass"
                android:contentDescription="Compass mode" />
        </LinearLayout>
        <!-- Playback controls (bottom center) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="14dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_map_button"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp">

            <ImageButton
                android:id="@+id/tac_detail_prev"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@android:color/transparent"
                android:src="@android:drawable/ic_media_previous"
                android:contentDescription="Prev" />

            <ImageButton
                android:id="@+id/tac_detail_play"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginHorizontal="6dp"
                android:background="@android:color/transparent"
                android:src="@android:drawable/ic_media_play"
                android:contentDescription="Play" />

            <ImageButton
                android:id="@+id/tac_detail_next"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@android:color/transparent"
                android:src="@android:drawable/ic_media_next"
                android:contentDescription="Next" />

            <TextView
                android:id="@+id/tac_detail_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="1/1"
                android:textColor="#00E5D1"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- [S5-nav] 나침반 방향 안내 바 (상단, 표적 탭 시 표시) -->
        <LinearLayout
            android:id="@+id/tac_nav_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/bg_map_button"
            android:paddingHorizontal="18dp"
            android:paddingVertical="10dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tac_nav_arrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="↑"
                android:textColor="#2ECC71"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tac_nav_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="정면 · 직진"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tac_nav_dist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="-"
                android:textColor="#B0C4DE"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tac_nav_warn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text=""
                android:textColor="#E74C3C"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- [S5-nav] 바다/개활지 모드: 큰 나침반 오버레이 (기본 숨김) -->
        <LinearLayout
            android:id="@+id/tac_compass_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#E60A1628"
            android:visibility="gone"
            android:clickable="true">

            <TextView
                android:id="@+id/tac_big_dist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-"
                android:textColor="#B0C4DE"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tac_big_arrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="↑"
                android:textColor="#2ECC71"
                android:textSize="120sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tac_big_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="정면 · 직진"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tac_big_warn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text=""
                android:textColor="#E74C3C"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="[ 탭하여 지도로 · Tap for map ]"
                android:textColor="#7A93B8"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- [S5-chat] survival message panel (overlay, bottom) -->
        <LinearLayout
            android:id="@+id/tac_surv_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical">

            <!-- collapsed peek bar -->
            <LinearLayout
                android:id="@+id/tac_surv_peek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#E60D1E33"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp"
                android:clickable="true">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="\u25B2"
                    android:textColor="#00E5D1"
                    android:textSize="12sp"
                    android:layout_marginEnd="8dp" />
                <TextView
                    android:id="@+id/tac_surv_peek_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="\uC548\uB0B4 \uBA54\uC2DC\uC9C0"
                    android:textColor="#B0C4DE"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- expanded panel -->
            <LinearLayout
                android:id="@+id/tac_surv_expanded"
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:orientation="vertical"
                android:background="#F00A1628"
                android:visibility="gone">

                <!-- handle (tap to collapse) -->
                <LinearLayout
                    android:id="@+id/tac_surv_handle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="#0D1E33"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="8dp"
                    android:clickable="true">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="\uAD00\uC81C \uC548\uB0B4"
                        android:textColor="#00E5D1"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="\u25BC"
                        android:textColor="#7A93B8"
                        android:textSize="12sp" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/tac_surv_msgs"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp"
                    android:clipToPadding="false" />

                <!-- input row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="#0D1E33"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="8dp">
                    <EditText
                        android:id="@+id/tac_surv_input"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="\uBA54\uC2DC\uC9C0 \uC785\uB825"
                        android:textColorHint="#5A6E88"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:maxLines="3"
                        android:background="#152A4A"
                        android:padding="10dp" />
                    <Button
                        android:id="@+id/tac_surv_send"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="\uC804\uC1A1"
                        android:textColor="#0A1628"
                        android:textStyle="bold"
                        android:backgroundTint="#00E5D1" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Element list -->
    <LinearLayout
        android:id="@+id/tac_detail_list_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.3"
        android:orientation="vertical"
        android:background="#0D1628">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#152238"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.2" android:text="CLASS" android:textColor="#4B6483" android:textSize="9sp" android:textStyle="bold" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.7" android:text="ID" android:textColor="#4B6483" android:textSize="9sp" android:textStyle="bold" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.3" android:text="AFFIL" android:textColor="#4B6483" android:textSize="9sp" android:textStyle="bold" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.4" android:text="LAT" android:textColor="#4B6483" android:textSize="9sp" android:textStyle="bold" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.4" android:text="LON" android:textColor="#4B6483" android:textSize="9sp" android:textStyle="bold" />
        </LinearLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/tac_detail_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </LinearLayout>
</LinearLayout>
