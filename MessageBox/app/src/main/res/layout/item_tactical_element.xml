<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="10dp"
    android:paddingVertical="7dp"
    android:background="?android:attr/selectableItemBackground">

    <TextView android:id="@+id/el_class" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.2" android:text="MARKER" android:textColor="#E0E6ED" android:textSize="10sp" android:textStyle="bold" />
    <TextView android:id="@+id/el_id" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.7" android:text="-" android:textColor="#9FB3C8" android:textSize="10sp" />
    <TextView android:id="@+id/el_affil" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.3" android:text="-" android:textColor="#9FB3C8" android:textSize="10sp" />
    <TextView android:id="@+id/el_lat" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.4" android:text="-" android:textColor="#6B8FAE" android:textSize="9sp" />
    <TextView android:id="@+id/el_lon" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.4" android:text="-" android:textColor="#6B8FAE" android:textSize="9sp" />
</LinearLayout>