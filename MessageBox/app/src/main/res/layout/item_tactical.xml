<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_input_card"
    android:paddingHorizontal="12dp"
    android:paddingVertical="10dp"
    android:layout_marginVertical="3dp">

    <View
        android:id="@+id/tac_item_bar"
        android:layout_width="4dp"
        android:layout_height="36dp"
        android:background="#00E5D1"
        android:layout_marginEnd="10dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tac_item_from"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TACTICAL"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tac_item_summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="markers 0"
            android:textColor="#9FB3C8"
            android:textSize="11sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tac_item_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#6B8FAE"
        android:textSize="10sp"
        android:layout_marginStart="8dp" />

    <ImageView
        android:id="@+id/tac_item_detail"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@android:drawable/ic_menu_more"
        android:layout_marginStart="8dp"
        android:contentDescription="Detail" />
</LinearLayout>